# Dados
# Local (dev): pasta do arquivo SQLite. Ignorado quando ZYRA_DB_URL existe.
ZYRA_DATA_DIR=/data

# Banco remoto (produção — Turso/libSQL). Deixe vazio no dev.
# ZYRA_DB_URL=libsql://zyra-sua-org.turso.io
# ZYRA_DB_AUTH_TOKEN=...

# Banco zerado (sem dados de exemplo). Use 1 para semear.
ZYRA_SEED=0

# Proteção por HTTP Basic Auth (obrigatória em produção).
ZYRA_USER=zyra
ZYRA_PASSWORD=troque-esta-senha

# Porta (padrão 3001)
PORT=3001
